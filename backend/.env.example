DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/invoice_db
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
# Optional: require token to configure LLM via API
LLM_CONFIG_TOKEN=
# Auth: JWT signing key (change to a long random string for production)
SECRET_KEY=
# Stable Fernet key shared by API and workflow worker. Generate once with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
NOTIFICATION_ENCRYPTION_KEY=
# Base URL reachable by notification recipients; links still require login.
PUBLIC_BASE_URL=http://localhost:15173
# Initial admin account created on first startup (ignored on later restarts)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
DEBUG=true
